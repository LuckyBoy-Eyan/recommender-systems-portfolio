{
  "seed": 2026,
  "interactions_path": "data/kuairec_big_v2/interactions_full.csv",
  "item_features_path": "data/kuairec_big_v2/sentence_t5_embeddings.npy",
  "semantic_codes_path": "data/kuairec_big_v2/rq_128_64_32/semantic_codes.npy",
  "min_positive_events": 5,
  "min_train_positive": 3,
  "max_history": 100,
  "max_train_samples_per_user": 100,
  "batch_size": 256,
  "num_workers": 4,
  "evaluation_batch_size": 256,
  "epochs": 100,
  "learning_rate": 0.0003,
  "warmup_epochs": 2,
  "min_learning_rate": 0.00001,
  "weight_decay": 0.01,
  "gradient_clip_norm": 1.0,
  "monitor_metric": "hitrate@200",
  "early_stopping_patience": 10,
  "device": "cuda",
  "mixed_precision": true,
  "topk": [5, 10, 20, 50, 100, 200],
  "hidden_dim": 256,
  "feedforward_dim": 1024,
  "num_layers": 6,
  "decoder_layers": 6,
  "num_heads": 4,
  "dropout": 0.1,
  "evaluation_mode": "beam",
  "beam_size": 200,
  "run_exact_evaluation": false,
  "validate_every_epoch": true,
  "resume_training": true,
  "semantic_id": {
    "method": "rq_kmeans",
    "codebook_sizes": [128, 64, 32],
    "tail_collision_token": true
  }
}

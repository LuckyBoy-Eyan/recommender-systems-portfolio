{
  "seed": 2026,
  "interactions_path": "data/kuairec_smoke_v2/interactions_full.csv",
  "item_features_path": "data/kuairec_smoke/item_embeddings/item_embeddings.npy",
  "min_positive_events": 5,
  "min_train_positive": 3,
  "max_history": 50,
  "target_stride": 25,
  "batch_size": 16,
  "evaluation_batch_size": 64,
  "epochs": 2,
  "learning_rate": 0.0003,
  "weight_decay": 0.01,
  "gradient_clip_norm": 1.0,
  "monitor_metric": "hitrate@20",
  "early_stopping_patience": 2,
  "device": "cpu",
  "mixed_precision": false,
  "topk": [5, 10, 20],
  "sasrec": {
    "hidden_dim": 64,
    "num_heads": 4,
    "num_layers": 1,
    "dropout": 0.1
  }
}

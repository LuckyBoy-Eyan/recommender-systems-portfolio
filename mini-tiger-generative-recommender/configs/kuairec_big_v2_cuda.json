{
  "seed": 2026,
  "interactions_path": "data/kuairec_big_v2/interactions_full.csv",
  "item_features_path": "data/kuairec_big_v2/sentence_t5_embeddings.npy",
  "semantic_codes_path": "data/kuairec_big_v2/rq_kmeans/semantic_codes.npy",
  "min_positive_events": 5,
  "min_train_positive": 3,
  "max_history": 100,
  "max_train_samples_per_user": 100,
  "target_stride": 50,
  "batch_size": 128,
  "evaluation_batch_size": 256,
  "epochs": 100,
  "learning_rate": 0.0003,
  "warmup_epochs": 2,
  "min_learning_rate": 0.00001,
  "weight_decay": 0.01,
  "gradient_clip_norm": 1.0,
  "monitor_metric": "hitrate@20",
  "early_stopping_patience": 10,
  "device": "cuda",
  "mixed_precision": true,
  "topk": [5, 10, 20],
  "hidden_dim": 192,
  "feedforward_dim": 768,
  "num_layers": 3,
  "decoder_layers": 3,
  "num_heads": 4,
  "dropout": 0.1,
  "evaluation_mode": "beam",
  "beam_size": 200,
  "run_exact_evaluation": true,
  "exact_evaluation_batch_size": 8,
  "catalog_chunk_size": 512,
  "validate_every_epoch": true,
  "resume_training": true,
  "sasrec": {
    "hidden_dim": 128,
    "num_heads": 4,
    "num_layers": 2,
    "dropout": 0.1
  },
  "semantic_id": {
    "method": "rq_kmeans",
    "codebook_sizes": [32, 32, 32],
    "tail_collision_token": true
  }
}

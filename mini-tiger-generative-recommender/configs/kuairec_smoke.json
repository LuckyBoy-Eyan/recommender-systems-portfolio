{
  "seed": 2026,
  "interactions_path": "data/kuairec_smoke/interactions.csv",
  "item_features_path": "data/kuairec_smoke/item_features.npy",
  "split_strategy": "temporal_leave_two_out",
  "min_sequence_length": 10,
  "min_train_sequence_length": 3,
  "max_sequence_length": 100,
  "max_train_samples_per_user": 30,
  "codebook_sizes": [32, 32, 32],
  "semantic_id_method": "rq_kmeans",
  "rq_backend": "auto",
  "rq_pca_dim": 48,
  "rq_whiten": true,
  "rq_l2_normalize": true,
  "rq_niter": 25,
  "rq_nredo": 3,
  "rq_use_gpu": false,
  "rq_max_balance_ratio": 1.25,
  "rq_resolve_collisions": true,
  "minibatch_kmeans_threshold": 5000,
  "max_history": 50,
  "hidden_dim": 64,
  "num_layers": 2,
  "num_heads": 4,
  "batch_size": 128,
  "epochs": 6,
  "validate_every_epoch": true,
  "monitor_metric": "recall@20",
  "early_stopping_patience": 2,
  "learning_rate": 0.001,
  "weight_decay": 0.01,
  "gradient_clip_norm": 1.0,
  "device": "cpu",
  "torch_num_threads": 1,
  "num_workers": 0,
  "evaluation_mode": "exact",
  "evaluation_batch_size": 32,
  "catalog_chunk_size": 256,
  "exclude_seen_items": true,
  "topk": [5, 10, 20],
  "run_random_baseline": true,
  "save_model": false
}

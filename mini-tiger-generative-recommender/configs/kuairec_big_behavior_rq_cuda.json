{
  "seed": 2026,
  "interactions_path": "data/kuairec_big/interactions.csv",
  "item_features_path": "data/kuairec_big/item_features.npy",
  "split_strategy": "temporal_leave_two_out",
  "min_sequence_length": 20,
  "min_train_sequence_length": 3,
  "max_sequence_length": 300,
  "max_train_samples_per_user": 100,
  "codebook_sizes": [64, 64, 64],
  "semantic_id_method": "rq_kmeans",
  "prebuilt_rq_index_dir": "outputs/kuairec_big_behavior_rq/index",
  "behavior_weight": 0.7,
  "content_feature_dim": 64,
  "behavior_pca_dim": 64,
  "content_pca_dim": 32,
  "rq_backend": "sklearn",
  "rq_pca_dim": null,
  "rq_whiten": false,
  "rq_l2_normalize": false,
  "rq_niter": 25,
  "rq_nredo": 3,
  "rq_use_gpu": false,
  "rq_max_balance_ratio": 1.25,
  "rq_resolve_collisions": true,
  "minibatch_kmeans_threshold": 5000,
  "max_history": 100,
  "hidden_dim": 192,
  "feedforward_dim": 720,
  "num_layers": 3,
  "num_heads": 4,
  "max_capacity_gap_ratio": 0.01,
  "sasrec": {
    "hidden_dim": 128,
    "num_heads": 4,
    "num_layers": 2,
    "dropout": 0.1
  },
  "batch_size": 256,
  "epochs": 10,
  "validate_every_epoch": true,
  "monitor_metric": "recall@20",
  "early_stopping_patience": 2,
  "learning_rate": 0.0003,
  "weight_decay": 0.01,
  "gradient_clip_norm": 1.0,
  "device": "cuda",
  "mixed_precision": true,
  "amp_dtype": "float16",
  "torch_num_threads": 4,
  "num_workers": 0,
  "evaluation_mode": "beam",
  "evaluation_batch_size": 64,
  "beam_size": 200,
  "exclude_seen_items": true,
  "topk": [5, 10, 20],
  "run_random_baseline": false,
  "save_model": true,
  "resume_training": true
}

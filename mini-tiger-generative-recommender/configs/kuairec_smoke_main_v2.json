{
  "seed": 2026,
  "interactions_path": "data/kuairec_smoke_v2/interactions_full.csv",
  "item_features_path": "data/kuairec_smoke/item_embeddings/content_embeddings.npy",
  "semantic_codes_path": "data/kuairec_smoke_v2/rq_kmeans_smoke/semantic_codes.npy",
  "min_positive_events": 5,
  "min_train_positive": 3,
  "max_history": 50,
  "max_train_samples_per_user": 20,
  "hidden_dim": 64,
  "feedforward_dim": 256,
  "num_layers": 1,
  "decoder_layers": 1,
  "num_heads": 4,
  "dropout": 0.1,
  "batch_size": 64,
  "evaluation_batch_size": 64,
  "epochs": 2,
  "learning_rate": 0.0003,
  "weight_decay": 0.01,
  "gradient_clip_norm": 1.0,
  "monitor_metric": "hitrate@20",
  "early_stopping_patience": 2,
  "device": "cpu",
  "mixed_precision": false,
  "evaluation_mode": "beam",
  "beam_size": 200,
  "validate_every_epoch": true,
  "resume_training": true,
  "topk": [5, 10, 20]
}
